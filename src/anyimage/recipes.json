{
  "about": "Fork addition (plan 40): settings Cosmos proposes for images whose own declaration is not enough. Data, not code: read by src/anyimage/recipes.go, checked by recipes_test.go and, against the real images, by recipes_live_test.go. Each recipe cites the image's documentation in 'source'. Volume 'evidence': declared (the image declares this VOLUME), workdir (its WORKDIR), env:NAME (a variable of the image points there or below), docs (only the documentation says so). 'runAs': the uid:gid the container runs as (first entry whose tagContains is in the tag), so that Cosmos makes the data folder its own; the live test checks the image's user has that id. A port marked 'undeclared' is opened by the recipe's command, not by the image. Env 'type': secret (a strong random value, generated in the browser), name (a value to choose, proposed), optional (shown folded, empty unless set), fixed (set as given).",
  "recipes": [
    {
      "id": "postgres",
      "name": "PostgreSQL",
      "images": ["postgres"],
      "source": "https://hub.docker.com/_/postgres",
      "kind": "database",
      "provides": "postgres",
      "pin": "major",
      "service": { "port": 5432 },
      "runAs": [{ "tagContains": "alpine", "user": "70:70" }, { "user": "999:999" }],
      "volumes": [
        { "target": "/var/lib/postgresql", "from": 18, "evidence": "declared", "backup": true },
        { "target": "/var/lib/postgresql/data", "until": 17, "evidence": "declared", "backup": true }
      ],
      "env": [
        { "name": "POSTGRES_PASSWORD", "type": "secret" },
        { "name": "POSTGRES_USER", "type": "name", "value": "app" },
        { "name": "POSTGRES_DB", "type": "name", "value": "app" }
      ],
      "healthcheck": { "test": ["CMD-SHELL", "pg_isready -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\""], "interval": "10s", "timeout": "5s", "retries": 5 },
      "memory": "256 MB to 1 GB",
      "backup": "pg_dumpall -U app",
      "notes": ["majorUpgrade", "pgdata18"],
      "client": { "url": "postgres://{user}:{password}@{host}:5432/{database}", "user": "POSTGRES_USER", "password": "POSTGRES_PASSWORD", "database": "POSTGRES_DB" }
    },
    {
      "id": "mariadb",
      "name": "MariaDB",
      "images": ["mariadb"],
      "source": "https://hub.docker.com/_/mariadb",
      "kind": "database",
      "provides": "mysql",
      "pin": "major",
      "prefer": ["lts"],
      "service": { "port": 3306 },
      "volumes": [{ "target": "/var/lib/mysql", "evidence": "declared", "backup": true }],
      "env": [
        { "name": "MARIADB_ROOT_PASSWORD", "type": "secret" },
        { "name": "MARIADB_DATABASE", "type": "name", "value": "app" },
        { "name": "MARIADB_USER", "type": "name", "value": "app" },
        { "name": "MARIADB_PASSWORD", "type": "secret" },
        { "name": "MARIADB_AUTO_UPGRADE", "type": "fixed", "value": "1" }
      ],
      "healthcheck": { "test": ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"], "interval": "10s", "timeout": "5s", "retries": 5 },
      "memory": "256 MB to 1 GB",
      "backup": "mariadb-dump --all-databases -u root -p",
      "client": { "url": "mysql://{user}:{password}@{host}:3306/{database}", "user": "MARIADB_USER", "password": "MARIADB_PASSWORD", "database": "MARIADB_DATABASE" }
    },
    {
      "id": "mysql",
      "name": "MySQL",
      "images": ["mysql"],
      "source": "https://hub.docker.com/_/mysql",
      "kind": "database",
      "provides": "mysql",
      "pin": "major",
      "prefer": ["lts"],
      "service": { "port": 3306 },
      "ports": [{ "port": 33060, "why": "xProtocol" }],
      "volumes": [{ "target": "/var/lib/mysql", "evidence": "declared", "backup": true }],
      "env": [
        { "name": "MYSQL_ROOT_PASSWORD", "type": "secret" },
        { "name": "MYSQL_DATABASE", "type": "name", "value": "app" },
        { "name": "MYSQL_USER", "type": "name", "value": "app" },
        { "name": "MYSQL_PASSWORD", "type": "secret" }
      ],
      "healthcheck": { "test": ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 --silent"], "interval": "10s", "timeout": "5s", "retries": 5 },
      "memory": "512 MB to 1 GB",
      "backup": "mysqldump --all-databases -u root -p",
      "client": { "url": "mysql://{user}:{password}@{host}:3306/{database}", "user": "MYSQL_USER", "password": "MYSQL_PASSWORD", "database": "MYSQL_DATABASE" }
    },
